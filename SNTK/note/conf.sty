%------------------------------------------------
% Команда для вывода строки конференции
\newcommand{\conferenceinfo}[2]{%
  \fancyhf{} 
  \fancyhead[C]{#1-я Научная Конференция Аспирантов, Магистрантов и Студентов БГУИР, г.~Минск, #2}
  \fancyfoot[C]{\thepage}
  \pagestyle{fancy} 
}


%------------------------------------------------
% Команда для вывода информации об авторе
\newcommand{\information}[1]{
\begin{center}
    {\normalsize #1}\\
    {\small Белорусский государственный университет информатики и радиоэлектроники}\\
    {\small г.~Минск, Республика Беларусь}
\end{center}
}

\newcommand{\informationEN}[1]{
\begin{center}
    {\normalsize #1}\\
    {\small Belarusian State University of Informatics and Radioelectronics}\\
    {\small Minsk, Republic of Belarus}
\end{center}
}

%------------------------------------------------
% Команда для вывода УДК
\newcommand{\udk}[1]{
\noindent\textbf{УДК}~#1
}

\newcommand{\udkEN}[1]{
\noindent\textbf{UDC}~#1
}

%------------------------------------------------
% Команда для вывода научного руководителя 
\newcommand{\supervisor}[1]{
\begin{flushright}
#1
\end{flushright}
}

\newcommand{\l@abcd}[2]{\noindent{\parbox[t]{\textwidth}{\raggedright #1\dotfill #2 }}}

%------------------------------------------------
% Команда для вывода темы без лишних отступов
\newcommand{\topic}[1]{
\begin{center}
    {\bfseries\Large\MakeUppercase{#1}}
\end{center}
}

%------------------------------------------------
% Команда для вставки аннотации
\newcommand{\annotation}[1]{
  {\noindent\bf{Аннотация. }\normalfont}
	\leftskip=1cm\rightskip=1cm\it\small\noindent{#1}  
	\normalsize\normalfont\leftskip=0cm \rightskip=0cm \indent }

\newcommand{\annotationEN}[1]{
  {\noindent\bf{Annotation. }\normalfont}
	\leftskip=1cm\rightskip=1cm\it\small\noindent{#1}  
	\normalsize\normalfont\leftskip=0cm \rightskip=0cm \indent \vspace{8pt}}

%------------------------------------------------
% Команда для вставки ключевых слов
\newcommand{\keyword}[1]{
  {\noindent\bf{Ключевые слова. }\normalfont}
	\leftskip=1cm\rightskip=1cm\it\small\noindent{#1}  
	\normalsize\normalfont\leftskip=0cm \rightskip=0cm \indent }

\newcommand{\keywordEN}[1]{
  {\noindent\bf{Keywords. }\normalfont}
	\leftskip=1cm\rightskip=1cm\it\small\noindent{#1}  
	\normalsize\normalfont\leftskip=0cm \rightskip=0cm \indent }

%------------------------------------------------
% Команда для работы с главами
\newcommand{\topChapter}[1]{{\normalsize\normalfont \leftskip=0cm \rightskip=0cm\bf \noindent #1 \\[10pt]}}
\newcommand{\content}[1]{\normalsize\normalfont\leftskip=0cm \rightskip=0cm \indent #1 }

%------------------------------------------------
% Команда для вставки списка источников
\newcounter{refcount}

% Среда для списка источников
\newenvironment{ListReferences}{
  \setcounter{refcount}{0}
  \par\small 
  \setlength{\parskip}{1pt}
  \setlength{\parsep}{0pt}
}{
  \par
}

%------------------------------------------------
% Команда для отдельного источника внутри среды
\newcommand{\refitem}[2]{
  \refstepcounter{refcount}
  \noindent[\arabic{refcount}]~#2\label{#1}\par
}

%------------------------------------------------
% Команда для вставки таблицы
\newcommand{\myTable}[2]{
\vspace{-10pt} 
\begin{table}[H]\small 
\noindent
\caption{#1}
    \centering
    \begin{tabularx}
        #2
    \end{tabularx}
\end{table}
\normalsize\normalfont\leftskip=0cm \rightskip=0cm\vspace{-10pt}
}

%------------------------------------------------
% Команда для вставки изображения png
\newcommand{\image}[1]{
\vspace{-8pt}
\begin{figure}[H]
\centering
\includegraphics #1
\end{figure}
\vspace{-8pt}
\normalsize\normalfont\leftskip=0cm\rightskip=0cm
}

